# Ignore everything by default
*

# But keep these three folders (fully)
!Behavioral Prep/
!Behavioral Prep/**

!Coding Prepare/
!Coding Prepare/**

!System Design Prep/
!System Design Prep/**

# Keep ONLY roadmap.html from this folder
!Daily Reference and Roadmap/
!Daily Reference and Roadmap/roadmap.html

# Keep .gitignore itself
!.gitignore

# Keep root index.html (landing page)
!index.html

# Keep .git folder (Git needs this)
!.git/

# Ignore .DS_Store files everywhere (must come AFTER the un-ignore rules)
.DS_Store
**/.DS_Store

# Re-ignore standard build artifacts and dependencies that might be inside the kept folders
**/node_modules/
**/dist/
**/build/
**/out/
**/.next/
**/.nuxt/
**/.output/
**/.cache/
**/.parcel-cache/
**/coverage/
**/.turbo/
**/.vercel/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# System
Thumbs.db
