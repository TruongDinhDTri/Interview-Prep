# Ignore everything by default
*

# But keep these three folders
!Behavioral Prep/
!Behavioral Prep/**

!Coding Prepare/
!Coding Prepare/**

!System Design Prep/
!System Design Prep/**

# Keep .gitignore itself
!.gitignore

# Keep root index.html (landing page)
!index.html

# Keep .git folder (Git needs this)
!.git/

# Optionally keep README if you want to add one later
# !README.md

# Ignore .DS_Store files everywhere (must come AFTER the un-ignore rules)
.DS_Store
**/.DS_Store
